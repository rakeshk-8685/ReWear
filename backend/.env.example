# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/rewear_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/rewear_db

# Security & Tokens
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Client Application URL
CLIENT_URL=https://rewear-api-cmrq.onrender.com

# Cloudinary Storage Configuration (Optional - for garment image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
