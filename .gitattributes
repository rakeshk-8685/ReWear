# ==========================================
# Git Attributes Line Ending Configuration
# ==========================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code and configuration source files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# Binary media & asset files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
